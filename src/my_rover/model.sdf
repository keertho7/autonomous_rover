<?xml version="1.0"?>
<sdf version="1.9">

<model name="my_rover">

  <!-- Chassis center is 0.10 m above the ground -->
  <pose>0 0 0.10 0 0 0</pose>

  <!-- ================= CHASSIS ================= -->

  <link name="chassis">

    <inertial>
      <mass>5.0</mass>
      <inertia>
        <ixx>0.05</ixx>
        <iyy>0.05</iyy>
        <izz>0.05</izz>
      </inertia>
    </inertial>

    <collision name="collision">
      <geometry>
        <box>
          <size>0.35 0.25 0.08</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>0.35 0.25 0.08</size>
        </box>
      </geometry>

      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.15 0.15 0.15 1</diffuse>
      </material>
    </visual>

  </link>

  <!-- ================= LEFT WHEEL ================= -->

  <link name="left_wheel">

    <pose>0 0.155 0 0 0 0</pose>

    <inertial>
      <mass>0.25</mass>
      <inertia>
        <ixx>0.0005</ixx>
        <iyy>0.0005</iyy>
        <izz>0.0005</izz>
      </inertia>
    </inertial>

    <collision name="collision">

      <pose>0 0 0 1.5708 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>

    </collision>

    <visual name="visual">

      <pose>0 0 0 1.5708 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>

      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.08 0.08 0.08 1</diffuse>
      </material>

    </visual>

  </link>

  <!-- ================= RIGHT WHEEL ================= -->

  <link name="right_wheel">

    <pose>0 -0.155 0 0 0 0</pose>

    <inertial>
      <mass>0.25</mass>
      <inertia>
        <ixx>0.0005</ixx>
        <iyy>0.0005</iyy>
        <izz>0.0005</izz>
      </inertia>
    </inertial>

    <collision name="collision">

      <pose>0 0 0 1.5708 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>

    </collision>

    <visual name="visual">

      <pose>0 0 0 1.5708 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>

      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.08 0.08 0.08 1</diffuse>
      </material>

    </visual>

  </link>

  <!-- ================= JOINTS ================= -->

  <joint name="left_wheel_joint" type="revolute">

    <parent>chassis</parent>
    <child>left_wheel</child>

    <pose>0 0.155 0 0 0 0</pose>

    <axis>
      <xyz>0 1 0</xyz>

      <limit>
        <lower>-1e16</lower>
        <upper>1e16</upper>
      </limit>

      <dynamics>
        <damping>0.01</damping>
      </dynamics>

    </axis>

  </joint>

  <joint name="right_wheel_joint" type="revolute">

    <parent>chassis</parent>
    <child>right_wheel</child>

    <pose>0 -0.155 0 0 0 0</pose>

    <axis>
      <xyz>0 1 0</xyz>

      <limit>
        <lower>-1e16</lower>
        <upper>1e16</upper>
      </limit>

      <dynamics>
        <damping>0.01</damping>
      </dynamics>

    </axis>

  </joint>

  <!-- ================= DIFF DRIVE ================= -->

  <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>

    <wheel_separation>0.31</wheel_separation>
    <wheel_radius>0.06</wheel_radius>

    <topic>cmd_vel</topic>

    <odom_topic>odom</odom_topic>
    <tf_topic>tf</tf_topic>

  </plugin>

</model>

</sdf>